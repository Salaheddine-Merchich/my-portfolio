# -----------------------------------------------------------------------------
# FICHIER D'EXEMPLE DES VARIABLES D'ENVIRONNEMENT
# Copiez ce fichier vers ".env" et remplissez les valeurs.
# NE JAMAIS pousser le fichier ".env" réel sur GitHub !
# -----------------------------------------------------------------------------

# --- CONFIGURATION GITHUB ---
# Pour fetch.js (Node) et l'application (React)
GITHUB_USERNAME=votre_nom_utilisateur_github
REACT_APP_GITHUB_TOKEN=votre_personal_access_token_ici
USE_GITHUB_DATA=true

# --- CONFIGURATION MEDIUM ---
MEDIUM_USERNAME=votre_nom_utilisateur_medium

# --- CONFIGURATION BASE DE DONNÉES (Exemple) ---
# DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/dbname

# --- SECRETS API & JWT (Exemple) ---
# JWT_SECRET=votre_secret_tres_long_et_aleatoire
# STRIPE_API_KEY=sk_test_...
